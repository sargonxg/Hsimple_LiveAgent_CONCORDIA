# ── CONCORDIA Environment Configuration ──────────────────────────────────────
# Copy this file to .env and fill in your values.

# Required: Gemini API key from https://aistudio.google.com/
GOOGLE_API_KEY=your_gemini_api_key_here

# When using Google AI Studio (default):
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# When using Vertex AI (set to TRUE and configure project):
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Model selection:
#   gemini-2.0-flash-live-001  → Real-time audio + text (recommended)
#   gemini-2.0-flash-exp        → Text only (fallback, cheaper)
CONCORDIA_MODEL=gemini-2.0-flash-live-001

# Voice for audio output (ignored in text-only mode):
# Available: Aoede, Charon, Fenrir, Kore, Puck, Orbit, Zephyr
CONCORDIA_VOICE=Aoede

# Server port (Cloud Run injects PORT automatically)
PORT=8080
